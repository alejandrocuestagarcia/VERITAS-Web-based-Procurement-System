# =============================================================================
# VERITAS - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# The .env file is git-ignored and will NOT be committed.
#
#   cp .env.example .env
#
# All variables below with empty values are REQUIRED for full functionality.
# Variables with defaults will work out-of-the-box for local development.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Defaults match the Docker Compose postgres service.
DB_HOST=localhost
DB_USERNAME=user
DB_PASSWORD=password

# --- Email (SMTP) ------------------------------------------------------------
# Required for password-reset emails and notifications.
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Security ----------------------------------------------------------------
# JWT signing key (min 256-bit / 32+ chars). Generate one with:
#   openssl rand -base64 32
JWT_SECRET_KEY=

# Encryption key for sensitive data (exactly 32 characters)
ENCRYPTION_KEY=
# Encryption salt (hex string)
ENCRYPTION_SALT=

# --- Password Reset ----------------------------------------------------------
PASSWORD_RESET_LINK_BASE=http://localhost:4200/reset-password

# --- Frontend URL ------------------------------------------------------------
APP_FRONTEND_URL=http://localhost:4200

# --- Currency Exchange API ---------------------------------------------------
# Sign up at https://www.exchangerate-api.com/ for a free key
EXCHANGE_RATE_API_KEY=
